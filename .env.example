# Bu dosya git'e GİRER; .env.local girmez. Amaç, depoyu klonlayan birinin hangi
# değişkenlerin gerektiğini görmesi — değerleri değil.

# --- Supabase (Faz 1+) ---
# İkisi de tarayıcıya gömülür ve gizli DEĞİLDİR; koruma anahtarda değil, RLS'te.
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Bu ikisi boş bırakılırsa uygulama "yalnız-yerel kip"te açılır: giriş ekranı
# yok, veri localStorage'da. Yani anahtarsız bir klon da çalışır.

# --- Sunucu tarafı, YALNIZCA Vercel'de (asla VITE_ öneki alma) ---
# VITE_ öneki alan her değişken derlenmiş pakete gömülür ve herkes tarafından
# okunabilir. Bu ikisi gizlidir, o yüzden öneksizler.
FINNHUB_KEY=
ALPHAVANTAGE_KEY=
